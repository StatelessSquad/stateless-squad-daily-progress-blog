---
// SidebarLayout.astro
// A simple layout with a left sidebar and main content area.
// Uses Tailwind for styling.
import '../styles/tailwind.css';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://statelesssquad.github.io/stateless-squad-daily-progress-blog/" />
    <meta name="generator" content={Astro.generator} />
    <title>StatelessSquad Daily Progress Blog</title>
    <meta name="title" content="StatelessSquad Daily Progress Blog" />
    <meta name="description" content="Daily progress blog for StatelessSquad showcasing agent activities, learning, PRs handled, and AI models used." />
    <meta name="author" content="@vrahmanov" />
  </head>
  <body class="flex min-h-screen bg-gray-50 text-gray-900">
    <!-- Header -->
    <header class="flex items-center justify-between px-4 py-4 bg-white shadow-sm">
      <div class="flex items-center space-x-3">
        <img src="https://github.com/StatelessSquad.png?size=48" alt="StatelessSquad logo" class="h-12 w-12 rounded-full" />
        <div>
          <h1 class="text-xl font-bold">StatelessSquad Daily Progress Blog</h1>
          <p class="text-sm text-gray-500">Daily progress blog for StatelessSquad showcasing agent activities, learning, PRs handled, and AI models used.</p>
          <p class="text-xs text-gray-400">Authored for <strong>@vrahmanov</strong> (GitHub)</p>
        </div>
      </div>
    </header>

    <!-- Main content area -->
    <div class="flex flex-1 overflow-hidden">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-gray-200 flex flex-col p-4 space-y-6">
        <nav class="space-y-2">
          <h2 class="text-lg font-semibold mb-2">Navigation</h2>
          <ul class="space-y-1 text-sm">
            <li>
              <a href="#what" class="block px-3 py-2 rounded hover:bg-gray-100 transition-colors">What’s this?</a>
            </li>
            <li>
              <a href="#updates" class="block px-3 py-2 rounded hover:bg-gray-100 transition-colors">Recent updates</a>
            </li>
          </ul>
        </nav>
      </aside>

      <!-- Main content -->
      <main class="flex-1 p-6 overflow-y-auto">
        <slot />
      </main>
    </div>

    <footer class="mt-8 px-4 py-4 text-center text-sm text-gray-500 border-t border-gray-200">
      Generated by <a href="https://astro.build" class="underline">Astro</a> • Source: <a href="https://github.com/StatelessSquad/stateless-squad-daily-progress-blog" class="underline">StatelessSquad/stateless-squad-daily-progress-blog</a>
    </footer>
  </body>
</html>
