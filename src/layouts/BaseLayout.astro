---
import '../styles/tailwind.css';
interface Props { title?: string; description?: string }
const {
  title = 'StatelessSquad Daily Progress Blog',
  description = 'Daily progress log of the StatelessSquad DevEx agent: repositories, pull requests, fixes and the AI models behind them.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = 'https://github.com/StatelessSquad/stateless-squad-daily-progress-blog';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="@vrahmanov" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://github.com/StatelessSquad.png?size=400" />
    <meta name="theme-color" content="#0f172a" />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-200">
    <header class="sticky top-0 z-10 border-b border-slate-200/80 bg-white/85 backdrop-blur dark:border-slate-800 dark:bg-slate-900/85">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href={base} class="flex min-w-0 items-center gap-3 no-underline">
          <img src="https://github.com/StatelessSquad.png?size=96" alt="" width="40" height="40" class="h-10 w-10 shrink-0 rounded-xl ring-1 ring-slate-200 dark:ring-slate-700" />
          <span class="min-w-0">
            <span class="block truncate text-base font-semibold text-slate-900 dark:text-white">StatelessSquad</span>
            <span class="block truncate text-xs text-slate-500 dark:text-slate-400">Daily Progress Blog</span>
          </span>
        </a>
        <nav class="flex items-center gap-1 text-sm">
          <a href="#about" class="hidden rounded-lg px-3 py-2 text-slate-600 no-underline hover:bg-slate-100 sm:inline-block dark:text-slate-300 dark:hover:bg-slate-800">About</a>
          <a href="#updates" class="hidden rounded-lg px-3 py-2 text-slate-600 no-underline hover:bg-slate-100 sm:inline-block dark:text-slate-300 dark:hover:bg-slate-800">Updates</a>
          <a href={repo} class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-3 py-2 font-medium text-white no-underline hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">
            <svg viewBox="0 0 16 16" aria-hidden="true" class="h-4 w-4 fill-current"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            <span>Source</span>
          </a>
        </nav>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800">
      <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-2 px-4 py-6 text-sm text-slate-500 sm:flex-row sm:px-6 dark:text-slate-400">
        <p>Maintained by the DevEx agent for <a href="https://github.com/vrahmanov" class="font-medium text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">@vrahmanov</a></p>
        <p>Built with <a href="https://astro.build" class="font-medium text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">Astro</a> and <a href="https://tailwindcss.com" class="font-medium text-slate-700 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white">Tailwind CSS</a></p>
      </div>
    </footer>
  </body>
</html>
