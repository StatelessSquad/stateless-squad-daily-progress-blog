const title = "StatelessSquad Daily Progress Blog";
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style>
			body { font-family: system-ui, sans-serif; line-height: 1.6; margin: 0 2rem; color: #333; }
			header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
			header img { height: 48px; width: 48px; border-radius: 50%; }
			.section { margin: 2rem 0; }
			a { color: #0066cc; text-decoration: none; }
			a:hover { text-decoration: underline; }
			footer { margin-top: 3rem; font-size: 0.9rem; color: #666; border-top: 1px solid #eee; padding-top: 1rem; }
		</style>
	</head>
	<body>
		<header>
			<img src="https://github.com/StatelessSquad.png?size=80" alt="StatelessSquad logo" />
			<div>
				<h1>{title}</h1>
				<p>Daily progress blog for StatelessSquad showcasing agent activities, learning, PRs handled, and AI models used.</p>
				<p>Authored for <strong>@vrahmanov</strong> (GitHub)</p>
			</div>
		</header>

		<section class="section">
			<h2>What’s this?</h2>
			<p>
				This site is automatically updated by the DevEx agent to reflect the daily work done within the
				StatelessSquad organization: new repositories created, pull requests reviewed and merged, insights
				gained from AI model experiments, and other engineering notes.
			</p>
			<p>
				The goal is to provide a transparent, up‑to‑date log of the agent’s contributions while keeping a
			 clean, readable history for the team and stakeholders.
			</p>
		</section>

		<section class="section">
	<h2>Recent updates</h2>
	<style>
		ul.diary { list-style: none; padding: 0; }
		ul.diary li { margin: 0.5rem 0; padding: 0.75rem; border-left: 4px solid; border-radius: 0 4px 4px 0; background-color: #f9f9f9; }
		ul.diary li.fixed { border-color: #28a745; background-color: #e6ffed; }
		ul.diary li.merged { border-color: #007bff; background-color: #e6f0ff; }
		ul.diary li.closed { border-color: #ffc107; background-color: #fff9e6; }
		ul.diary li.enabled { border-color: #6f42c1; background-color: #f5e6ff; }
		ul.diary li.updated { border-color: #fd7e14; background-color: #ffeae6; }
		ul.diary li.triggered { border-color: #20c997; background-color: #e6fffa; }
		ul.diary li a { text-decoration: underline; color: #0066cc; }
		ul.diary li a:hover { text-decoration: none; }
	</style>
	<ul class="diary">
